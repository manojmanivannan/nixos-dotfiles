--- a/modules/bar/components/StatusIcons.qml
+++ b/modules/bar/components/StatusIcons.qml
@@ -142,6 +142,49 @@
                         }
                     }
                 }
+                DelegateChoice {
+                    roleValue: "tailscale"
+                    delegate: EntryWrapper {
+                        // Tailscale icon (WF-13 — the one ported custom module).
+                        // Rebased for v2.5.0's model-driven EntryWrapper rewrite
+                        // (the v2.2.0 WrappedLoader version is gone). The
+                        // EntryWrapper's name derives from the modelData id
+                        // ("tailscale"), which the bar's popout wiring matches
+                        // to the TailscalePopout in modules/bar/popouts/
+                        // Content.qml (0002) on hover.
+                        Item {
+                            readonly property int tsSize: Math.round(Tokens.font.body.large.pointSize * 1.2)
+
+                            implicitWidth: tsSize
+                            implicitHeight: tsSize
+
+                            Image {
+                                id: tsIcon
+
+                                anchors.fill: parent
+                                fillMode: Image.PreserveAspectFit
+                                mipmap: true
+                                smooth: true
+                                source: Tailscale.up
+                                    ? Quickshell.shellPath("assets/tailscale_on.png")
+                                    : Quickshell.shellPath("assets/tailscale_off.png")
+                            }
+
+                            MouseArea {
+                                anchors.fill: parent
+                                acceptedButtons: Qt.LeftButton | Qt.RightButton
+                                cursorShape: Qt.PointingHandCursor
+
+                                onClicked: event => {
+                                    if (event.button === Qt.LeftButton)
+                                        Tailscale.toggle();
+                                    else if (event.button === Qt.RightButton)
+                                        Tailscale.switchProfile();
+                                }
+                            }
+                        }
+                    }
+                }
             }
         }
     }
