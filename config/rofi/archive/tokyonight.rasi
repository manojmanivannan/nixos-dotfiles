/*
 * Tokyonight colorscheme for rofi (Wayland/Hyprland-safe)
 *
 * Replaces the original "screenshot" transparency variant, which is broken
 * under Wayland: rofi cannot capture the root window, so the launcher
 * rendered as a black/garbage blob and was unreadable. This version uses a
 * real semi-transparent background instead.
 */

// TokyoNight Night palette
* {
    bg:           #585963;          // night background
    bg-alt:       #6a6b73;          // night bg highlight
    fg:           #d4daf2;          // night foreground
    fg-dim:       #81869d;          // night comment / dim
    accent:       #7aa2f7;          // night blue
    accent2:      #bb9af7;          // night purple
    selected:     #33467c;          // night bg selection
    urgent:       #f7768e;          // night red
    border:       #2ac3de;          // night cyan
    transparent:  rgba(26,27,38,0);

    background-color: @transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";

    margin:    0;
    padding:   0;
    spacing:   0;
    border:    0;
    highlight: none;
}

// ---- window -------------------------------------------------------------
window {
    width:                       560px;
    location:                    center;
    anchor:                      center;
    transparency:                "real";        // works on Wayland (no screenshot grab)
    background-color:            rgba(26,27,38,0.92);
    border:                      2px solid;
    border-color:                @border;
    border-radius:               12px;
    padding:                     12px;
    children:                    [ mainbox ];
}

mainbox {
    children:    [ inputbar, listview ];
    spacing:     8px;
}

// ---- input bar ----------------------------------------------------------
inputbar {
    children:      [ prompt, entry ];
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          10px 14px;
    spacing:          8px;
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
    padding:          0px 6px 0px 0px;
}

entry {
    text-color:       @fg;
    placeholder:      "Search...";
    placeholder-color:@fg-dim;
    cursor:           text;
}

// ---- list ---------------------------------------------------------------
listview {
    background-color: @transparent;
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    padding:          4px 0px 0px 0px;
    spacing:          2px;
}

element {
    background-color: @transparent;
    text-color:       @fg;
    padding:          8px 12px;
    border-radius:    6px;
    spacing:          10px;
    cursor:           pointer;
}

element selected.normal {
    background-color: @selected;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @transparent;
    text-color:       @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element normal.active {
    background-color: @transparent;
    text-color:       @accent2;
}

element selected.active {
    background-color: @accent2;
    text-color:       @bg;
}

element-icon {
    background-color: inherit;
    text-color:       inherit;
    size:             24px;
    margin:           0px 4px 0px 0px;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}