{
  // WF-15 — the custom waybar scripts (cava/sysinfo/disk/weather/netspeed/
  // autoreload + the waybar tailscale copy, relocated to caelestia/scripts/ in
  // WF-13) are retired: caelestia's dashboard built-ins now cover cava (native
  // CavaProvider), CPU/GPU/mem/temp (Performance tab), disk (Storage card),
  // weather (Weather tab + widget), and media (Media tab, so the waybar `mpris`
  // module is gone too). The tailscale status icon is caelestia's ported module
  // (WF-13), not this bar. The custom/* modules and now-empty groups that
  // referenced those scripts are removed so nothing here points at deleted
  // files. This config is the main-branch fallback bar; on the `quickshell`
  // branch caelestia.service is the shell and waybar is not launched, and the
  // whole waybar dir is removed in WF-16.
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 60,
  "margin-top": 6,
  "margin-left": 6,
  "margin-right": 6,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window",
  ],
  "modules-center": [
    "group/center"
  ],
  "modules-right": [
    "tray",
    "group/audio",
    "group/net",
    "custom/notification",
    "custom/power"
  ],
  "group/center": {
    "orientation": "horizontal",
    "modules": [
      "clock"
    ]
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "hyprland/window": {
    "format": "{}",
    "separate-outputs": true,
    "icon-size": 14,
    "icon": true
  },
  // Grouped status pills (right side). Each group renders as one rounded
  // pill with separator-divided children; see style.css `#group-*`.
  "group/audio": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio"
    ]
  },
  "group/net": {
    "orientation": "horizontal",
    "modules": [
      "network",
      // "bluetooth",
    ]
  },
  // Notification bell — swaync bridge. `swaync-client -swb` subscribes and
  // emits waybar JSON on every add/close, so the count updates instantly
  // with no polling. Emitted shape: {text:"<count>",alt/class:"<state>"}
  // where state ∈ {notification, none, dnd}. `text` is the count ("" when 0).
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "tooltip": false,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "clock": {
    "format": "  {:%H:%M  %d %b}",
    "format-alt": "  {:%A, %d %B %Y}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 4,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#e8c272'><b>{}</b></span>",
        "days": "<span color='#f0e6d2'><b>{}</b></span>",
        "weeks": "<span color='#c08a4f'><b>W{}</b></span>",
        "weekdays": "<span color='#d99069'><b>{}</b></span>",
        "today": "<span color='#e5805f'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " Muted",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%"
  },
  "network": {
    "format": "{icon}",
    "format-wifi": "  {essid}",
    "format-ethernet": "  Wired",
    "format-disconnected": "  Offline",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    // Tooltip consolidates IP + live throughput here (formerly a separate
    // custom/netspeed pill next to the clock). {ip} and {bandwidth*Bits} are
    // native network-module tokens, so no extra script is needed; the tooltip
    // refreshes with `interval` while hovered.
    "tooltip-format-ethernet": "{ifname}  {ipaddr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ipaddr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "tooltip-format-disconnected": "Offline",
    "interval": 3,
    "on-click": "nm-connection-editor"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 12
  },
  "custom/power": {
    "on-click": "wlogout --protocol layer-shell",
    "format": " ⏻ "
  }
}
