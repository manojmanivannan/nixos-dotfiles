{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 38,
  "margin-top": 6,
  "margin-left": 6,
  "margin-right": 6,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window",
    "mpris",
    "custom/cava"
  ],
  "modules-center": [
    "group/center"
  ],
  "modules-right": [
    "group/audio",
    "group/net",
    "group/mem",
    "group/sys",
    "group/gpu",
    "group/disk",
    "custom/notification",
    "tray",
    "custom/power"
  ],
  "group/center": {
    "orientation": "horizontal",
    "modules": ["custom/weather", "clock", "custom/netspeed"]
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "hyprland/window": {
    "format": "{}",
    "separate-outputs": true,
    "icon-size": 14,
    "icon": true
  },
  // Now-playing pill (left, after window title). Auto-discovers any
  // MPRIS-capable player via playerctl — no script needed.
  "mpris": {
    "format": "{status_icon} {artist} - {title}",
    "format-paused": "{status_icon} {artist} - {title}",
    "format-stopped": "",
    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": ""
    },
    "max-length": 50,
    "ignored": "",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl volume 0.05+",
    "on-scroll-down": "playerctl volume 0.05-"
  },
  // Cava audio spectrum (left, after the now-playing track). scripts/cava.sh
  // streams Nerd Font block-character bars at ~30fps as a long-running exec
  // (read continuously like the swaync bell). Auto-collapses with class
  // "silent" when nothing is playing — see style.css `#custom-cava.silent`.
  "custom/cava": {
    "exec": "$HOME/.config/waybar/scripts/cava.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": false
  },
  // Grouped status pills (right side). Each group renders as one rounded
  // pill with separator-divided children; see style.css `#group-*`.
  "group/audio": {
    "orientation": "horizontal",
    "modules": ["pulseaudio"]
  },
  "group/net": {
    "orientation": "horizontal",
    "modules": ["network", "bluetooth"]
  },
  "group/mem": {
    "orientation": "horizontal",
    "modules": ["custom/mem"]
  },
  "group/sys": {
    "orientation": "horizontal",
    "modules": ["custom/cpu", "custom/cpu-temp"]
  },
  "group/gpu": {
    "orientation": "horizontal",
    "modules": ["custom/gpu", "custom/gpu-temp"]
  },
  // Root filesystem usage — its own pill in the right resource cluster, after
  // the GPU group. See style.css `#group-disk`.
  "group/disk": {
    "orientation": "horizontal",
    "modules": ["custom/disk"]
  },
  // Notification bell — swaync bridge. `swaync-client -swb` subscribes and
  // emits waybar JSON on every add/close, so the count updates instantly
  // with no polling. Emitted shape: {text:"<count>",alt/class:"<state>"}
  // where state ∈ {notification, none, dnd}. `text` is the count ("" when 0).
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd": ""
    },
    "tooltip": false,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  // Weather pill, grouped with the clock in the center (group/center).
  // wttr.in geo-locates by IP — no key, no location config. Cached + fault
  // tolerant (see scripts/weather.sh). Slow interval: weather barely changes.
  "custom/weather": {
    "exec": "$HOME/.config/waybar/scripts/weather.sh",
    "interval": 600,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "xdg-open https://wttr.in",
    "on-click-right": "$HOME/.config/waybar/scripts/weather.sh"
  },
  "clock": {
    "format": "  {:%H:%M  %d %b}",
    "format-alt": "  {:%A, %d %B %Y}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 4,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#e8c272'><b>{}</b></span>",
        "days": "<span color='#f0e6d2'><b>{}</b></span>",
        "weeks": "<span color='#c08a4f'><b>W{}</b></span>",
        "weekdays": "<span color='#d99069'><b>{}</b></span>",
        "today": "<span color='#e5805f'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " Muted",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%"
  },
  "network": {
    "format": "{icon}",
    "format-wifi": "  {essid}",
    "format-ethernet": "  Wired",
    "format-disconnected": "  Offline",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "interval": 3,
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "  {num_connections}",
    "format-no-controller": "",
    "tooltip-format": "{num_connections} device(s) connected",
    "on-click": "blueman-manager"
  },
  // Live network throughput, grouped with the clock in the center (to its
  // right). scripts/netspeed.sh keeps a state file so each run is instant;
  // interval=1 gives ~1s updates with no in-script sleep.
  "custom/netspeed": {
    "exec": "$HOME/.config/waybar/scripts/netspeed.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "tooltip": true
  },
  "custom/cpu": {
    // 1s-average utilization, padded to 3 chars so the pill never shifts.
    "exec": "$HOME/.config/waybar/scripts/sysinfo.sh cpu",
    "interval": 2,
    "format": "CPU {}%",
    "on-click": "ghostty -e btop"
  },
  "custom/mem": {
    "exec": "$HOME/.config/waybar/scripts/sysinfo.sh mem",
    "interval": 5,
    "format": "MEM {}%",
    "on-click": "ghostty -e btop"
  },
  "custom/cpu-temp": {
    // k10temp Tctl. The script colors the number red at >=80C via a Pango
    // span; below that the module CSS color applies. k10temp is found by name
    // (hwmon indices shift across reboots)
    "exec": "$HOME/.config/waybar/scripts/sysinfo.sh cputemp",
    "format": "{}°C  ",
    "interval": 2
  },
  "custom/gpu": {
    "exec": "$HOME/.config/waybar/scripts/sysinfo.sh gpu",
    "format": "GPU {}%",
    "interval": 2,
    "on-click": "ghostty -e nvitop"
  },
  "custom/gpu-temp": {
    "exec": "$HOME/.config/waybar/scripts/sysinfo.sh gputemp",
    "format": "{}°C ",
    "interval": 2
  },
  // Root filesystem usage, wrapped in group/disk (right, after the GPU
  // group). Slow interval — disk usage barely moves. scripts/disk.sh emits
  // the percent for the pill (the `format` adds the "DISK" label, matching
  // the CPU/MEM/GPU pills) and a used/total/free breakdown for the tooltip.
  "custom/disk": {
    "exec": "$HOME/.config/waybar/scripts/disk.sh",
    "return-type": "json",
    "format": "DISK {}",
    "interval": 300,
    "tooltip": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 12
  },
  "custom/power": {
    "on-click": "wlogout --protocol layer-shell",
    "format": " ⏻ "
  }
}