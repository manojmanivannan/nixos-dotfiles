# Ghostty terminal configuration
# Replaces the previous kitty setup. Catppuccin Macchiato palette mirrored
# from home/.config/kitty/kitty.conf (Catppuccin Macchiato theme).

# Advertise a universally-recognized TERM so remote hosts (Debian, etc.)
# have the terminfo entry built in — SSH forwards TERM, and an unknown
# xterm-ghostty on the remote breaks zsh's line editor (doubled keystrokes,
# garbled prompt). Trade-off: loses a few Ghostty-specific terminfo
# capabilities locally (undercurl, styled underlines).
term = xterm-256color

# JetBrainsMono Nerd Font (installed via nixos/modules/desktop/fonts.nix)
# carries the Powerline/Nerd glyphs, so remote prompts (e.g. oh-my-zsh) no
# longer render triangle separators as "?".
font-family            = JetBrainsMono Nerd Font
font-family-bold       = JetBrainsMono Nerd Font
font-family-italic     = JetBrainsMono Nerd Font
font-family-bold-italic = JetBrainsMono Nerd Font
font-size = 14.0

# Catppuccin Macchiato
foreground = #cad3f5
background = #24273a
selection-foreground = #24273a
selection-background = #f4dbd6
cursor-color = #f4dbd6
cursor-text = #24273a

# 16 terminal colors
palette = 0=#494d64
palette = 1=#ed8796
palette = 2=#a6da95
palette = 3=#eed49f
palette = 4=#8aadf4
palette = 5=#f5bde6
palette = 6=#8bd5ca
palette = 7=#b8c0e0
palette = 8=#5b6078
palette = 9=#ed8796
palette = 10=#a6da95
palette = 11=#eed49f
palette = 12=#8aadf4
palette = 13=#f5bde6
palette = 14=#8bd5ca
