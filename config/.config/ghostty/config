# Ghostty terminal configuration
# Replaces the previous kitty setup. Warm-metal palette (brushed gold / copper
# / bronze on espresso) — mirrored from the linux console colors in
# nixos/modules/desktop/theme.nix.

# Advertise a universally-recognized TERM so remote hosts (Debian, etc.)
# have the terminfo entry built in — SSH forwards TERM, and an unknown
# xterm-ghostty on the remote breaks zsh's line editor (doubled keystrokes,
# garbled prompt). Trade-off: loses a few Ghostty-specific terminfo
# capabilities locally (undercurl, styled underlines).
term = xterm-256color

# JetBrainsMono Nerd Font (installed via nixos/modules/desktop/fonts.nix)
# carries the Powerline/Nerd glyphs, so remote prompts (e.g. oh-my-zsh) no
# longer render triangle separators as "?".
font-family            = JetBrainsMono Nerd Font
font-family-bold       = JetBrainsMono Nerd Font
font-family-italic     = JetBrainsMono Nerd Font
font-family-bold-italic = JetBrainsMono Nerd Font
font-size = 14.0

# Warm-metal theme: brushed gold / copper / bronze on warm espresso
# backgrounds, slightly darkened. Mirrored in the linux console colors
# (nixos/modules/desktop/theme.nix), the Caelestia shell scheme
# (config/.config/caelestia/scheme/scheme.json), and GTK/libadwaita
# (config/.config/gtk-{3,4}.0/gtk.css).
foreground = #f0e6d2
background = #322a21
selection-foreground = #322a21
selection-background = #e8c272
cursor-color = #e8c272
cursor-text = #3d3329

# 16 terminal colors — warm metallic accents on light-taupe neutrals.
# ANSI red/green/yellow stay functional but earthy; blue/cyan/magenta are
# desaturated patina/steel/rose so they read apart without going cool.
palette = 0=#5c4d3d
palette = 1=#e5805f
palette = 2=#b3bf80
palette = 3=#e6c25a
palette = 4=#94a6ba
palette = 5=#d99a9a
palette = 6=#84baa7
palette = 7=#f0e6d2
palette = 8=#6f5d49
palette = 9=#e8906a
palette = 10=#c2cc94
palette = 11=#eed27a
palette = 12=#a4b4c8
palette = 13=#e6aaaa
palette = 14=#97c8b6
palette = 15=#f6eed8