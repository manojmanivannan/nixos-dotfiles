[Unit]
Description=Run NAS backup daily and on boot if missed

[Timer]
# Run every Saturday at 3 AM
OnCalendar=Sat *-*-* 03:00:00
# THE MAGIC SETTING: If machine was off at 3am, run immediately on boot
Persistent=true
# Add a slight delay on boot to ensure Wi-Fi/LAN is fully stable
OnStartupSec=5min

[Install]
WantedBy=timers.target