{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 38,
  "margin-top": 6,
  "margin-left": 6,
  "margin-right": 6,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/audio",
    "group/net",
    "group/sys",
    "group/gpu",
    "tray",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "hyprland/window": {
    "format": "{}",
    "separate-outputs": true,
    "icon-size": 14,
    "icon": true
  },
  // Grouped status pills (right side). Each group renders as one rounded
  // pill with separator-divided children; see style.css `#group-*`.
  "group/audio": {
    "orientation": "horizontal",
    "modules": ["pulseaudio"]
  },
  "group/net": {
    "orientation": "horizontal",
    "modules": ["network", "bluetooth"]
  },
  "group/sys": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "temperature"]
  },
  "group/gpu": {
    "orientation": "horizontal",
    "modules": ["custom/gpu", "custom/gpu-temp"]
  },
  "clock": {
    "format": "  {:%H:%M  %d %b}",
    "format-alt": "  {:%A, %d %B %Y}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 4,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#c6a0f6'><b>{}</b></span>",
        "days": "<span color='#cad3f5'><b>{}</b></span>",
        "weeks": "<span color='#8aadf4'><b>W{}</b></span>",
        "weekdays": "<span color='#f5a97f'><b>{}</b></span>",
        "today": "<span color='#ed8796'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " Muted",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%"
  },
  "network": {
    "format": "{icon}",
    "format-wifi": "  {essid}",
    "format-ethernet": "  Wired",
    "format-disconnected": "  Offline",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "interval": 3,
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "  {num_connections}",
    "format-no-controller": "",
    "tooltip-format": "{num_connections} device(s) connected",
    "on-click": "blueman-manager"
  },
  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "on-click": "alacritty -e btop"
  },
  "memory": {
    "interval": 10,
    "format": "  {percentage}%",
    "on-click": "alacritty -e btop"
  },
  "temperature": {
    // AMD k10temp (CPU Tctl). hwmon indices can shift across reboots; if this
    // module disables itself, re-check `for h in /sys/class/hwmon/hwmon*; do
    // cat $h/name; done` and point hwmon-path at the k10temp entry.
    "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
    "critical-threshold": 80,
    "format": "  {temperatureC}°C",
    "format-critical": "  {temperatureC}°C"
  },
  "custom/gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    "format": "  {}%",
    "interval": 2,
    "on-click": "alacritty -e nvitop"
  },
  "custom/gpu-temp": {
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
    "format": "  {}°C",
    "interval": 2
  },
  "tray": {
    "icon-size": 16,
    "spacing": 12
  },
  "custom/power": {
    "on-click": "wlogout --protocol layer-shell",
    "format": " ⏻ "
  }
}